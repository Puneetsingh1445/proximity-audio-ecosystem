# Leave blank for local demo mode. Set this to your teammate's Socket.IO URL for multiplayer.
VITE_SOCKET_URL=

# Proposed defaults; align these names with the backend implementation.
VITE_SOCKET_JOIN_EVENT=player:join
VITE_SOCKET_MOVE_EVENT=player:move
VITE_SOCKET_PLAYERS_EVENT=players:update
VITE_SOCKET_LEAVE_EVENT=player:leave
